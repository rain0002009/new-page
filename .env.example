# Chrome Web Store API v2 credentials (copy to .env.local and fill in real values)
# Never commit .env.local or real secrets.

# OAuth2 Desktop/Web client credentials from Google Cloud Console
CWS_CLIENT_ID=
CWS_CLIENT_SECRET=

# Obtain via: pnpm publish:cws --auth
CWS_REFRESH_TOKEN=

# Chrome Web Store Publisher ID (Account > Publisher ID in Developer Dashboard)
CWS_PUBLISHER_ID=

# Chrome Web Store Extension ID (defaults to Page Garden's published ID in README.md)
CWS_EXTENSION_ID=fonjkepbgbaijaghboomgbkpohhopomm
