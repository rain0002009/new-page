  "version": "1.5.0",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@floating-ui/react": "^0.27.20",
    "@milkdown/crepe": "^7.23.0",
    "@milkdown/kit": "^7.23.0",
    "@noble/hashes": "^2.4.0",
    "@tanstack/react-query": "^5.107.1",
    "dayjs": "^1.11.23",
    "fluid-prism": "0.1.4",
    "lucide-react": "^1.70.0",
    "overlayscrollbars": "^2.17.0",
    "overlayscrollbars-react": "^0.5.7",
    "qrcode.react": "^4.2.0",
    "react": "^18.1.0",
    "react-dom": "^18.1.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tailwind-variants": "^4.0.1",
    "unified": "^11.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@unocss/postcss": "^66.12.0",
    "extension": "^4.1.39",
    "selfsigned": "^5.5.0",
    "typescript": "7.0.2",
    "unocss": "^66.12.0",
    "vitest": "^5.1.1"
  },
  "scripts": {
    "dev": "extension dev --browser chrome",
    "dev:chrome": "extension dev --browser chrome",
    "start": "extension start --browser chrome",
    "build": "extension build --browser chrome",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "vitest run && pnpm build:chrome && playwright test",
    "preview": "extension preview --browser chrome",
    "build:chrome": "extension build --browser chrome",
    "package:chrome": "node scripts/prepare-chrome-store.mjs"
  },
  "packageManager": "pnpm@12.16.1",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "less"
    ]
  }
}
