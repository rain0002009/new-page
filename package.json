    "qrcode.react": "^4.2.0",
    "react": "^18.1.0",
    "react-dom": "^18.1.0",
    "tailwind-variants": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@unocss/postcss": "^66.12.0",
    "extension": "^4.1.39",
    "selfsigned": "^5.5.0",
    "typescript": "7.0.2",
    "unocss": "^66.12.0"
  },
  "scripts": {
    "dev": "extension dev",
    "dev:chrome": "extension dev --browser chrome",
